# Food Craft AI Backend — Environment Configuration
# Copy this file to .env and fill in your values.

# Hugging Face Token (optional — only needed for private repos)
HF_TOKEN=

# Number of recipes to index (set 0 for ALL 2.2M+)
INDEX_MAX_RECIPES=50000

# SBERT encoding batch size (lower = less RAM, higher = faster)
INDEX_BATCH_SIZE=512

# YOLOv8 detection confidence threshold (0.0 - 1.0)
YOLO_CONFIDENCE_THRESHOLD=0.35

# Debug mode (set False in production)
DEBUG=True
