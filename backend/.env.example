# Food Craft AI Backend — Environment Configuration
# Copy this file to .env and fill in your values.

# Hugging Face Token (needed for private repos, dataset uploads, and model pushes)
HF_TOKEN=

# Fine-tuned Hugging Face Vision Model integration
HF_VISION_MODEL_ID=pavankumarpalla/FoodCraft-Llama-3.2-11B-Vision
HF_VISION_LORA_ID=pavankumarpalla/FoodCraft-Llama-3.2-11B-Vision-LoRA
HF_VISION_INFERENCE_URL=https://pavankumarpalla-foodcraft-vision-api.hf.space
HF_VISION_USE_ROUTER=False

# Number of recipes to index (set 0 for ALL 2.2M+)
INDEX_MAX_RECIPES=50000

# SBERT encoding batch size (lower = less RAM, higher = faster)
INDEX_BATCH_SIZE=512

# YOLOv8 detection confidence threshold (0.0 - 1.0)
YOLO_CONFIDENCE_THRESHOLD=0.35

# Debug mode (set False in production)
DEBUG=True
